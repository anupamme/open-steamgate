{
  "_version": "1.59.0",
  "sap.app": {
    "id": "stg.taxi",
    "type": "application",
    "title": "NYC taxi analytics",
    "description": "Analytical list page over NYC TLC yellow taxi trips",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "dataSources": {
      "mainService": {
        "uri": "../../../../opu/odata/sap/ZSTG_SADL_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "annotations": [
            "localAnnotations"
          ]
        }
      },
      "localAnnotations": {
        "uri": "annotations/annotations.xml",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "annotations/annotations.xml"
        }
      },
      "taxiData": {
        "uri": "../../../../opu/odata/sap/ZSTG_SADL_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Taxi-analyze": {
          "semanticObject": "Taxi",
          "action": "analyze",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.suite.ui.generic.template": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "stg.taxi.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "useBatch": true,
          "defaultCountMode": "Inline",
          "defaultBindingMode": "TwoWay",
          "refreshAfterChange": false
        }
      },
      "taxiData": {
        "dataSource": "taxiData",
        "settings": {
          "useBatch": false,
          "defaultCountMode": "None"
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.suite.ui.generic.template.AnalyticalListPage.view.AnalyticalListPage": {
            "controllerName": "stg.taxi.ext.controller.ListReportExt",
            "sap.ui.generic.app": {
              "Zc_Osd_TaxicubeSet": {
                "EntitySet": "Zc_Osd_TaxicubeSet",
                "Actions": {
                  "GenerateData": {
                    "id": "GenerateDataButton",
                    "text": "{{GenerateData}}",
                    "press": "onGenerateData",
                    "requiresSelection": false,
                    "global": true
                  },
                  "ResetData": {
                    "id": "ResetDataButton",
                    "text": "{{ResetData}}",
                    "press": "onResetData",
                    "requiresSelection": false,
                    "global": true
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.ui.generic.app": {
    "_version": "1.3.0",
    "settings": {
      "flexibilityEnabled": false
    },
    "pages": {
      "AnalyticalListPage|Zc_Osd_Taxicube": {
        "entitySet": "Zc_Osd_TaxicubeSet",
        "component": {
          "name": "sap.suite.ui.generic.template.AnalyticalListPage",
          "list": true,
          "settings": {
            "tableType": "AnalyticalTable",
            "defaultContentView": "charttable",
            "defaultFilterMode": "compact",
            "autoHide": false,
            "showGoButton": false,
            "condensedTableLayout": true,
            "smartVariantManagement": false,
            "dataLoadSettings": {
              "loadDataOnAppLaunch": "always"
            }
          }
        }
      }
    }
  }
}
