CLASS zcl_gogen_t_dynrecvsupplied DEFINITION PUBLIC FINAL CREATE PUBLIC.
 PUBLIC SECTION.
 CLASS-METHODS val IMPORTING p TYPE i OPTIONAL RETURNING VALUE(r) TYPE i.
 CLASS-METHODS literal IMPORTING p TYPE i OPTIONAL RETURNING VALUE(r) TYPE string.
 CLASS-METHODS run RETURNING VALUE(rv) TYPE string.
ENDCLASS.
CLASS zcl_gogen_t_dynrecvsupplied IMPLEMENTATION.
 METHOD val. IF p IS SUPPLIED. r = p. ELSE. r = 42. ENDIF. ENDMETHOD.
 METHOD literal.
 IF 'p IS SUPPLIED' = 'p IS SUPPLIED'. r = 'literal'. ENDIF.
 ENDMETHOD.
 METHOD run.
 DATA x TYPE i.
 CALL METHOD ('ZCL_GOGEN_T_DYNRECVSUPPLIED')=>('VAL') RECEIVING r = x.
 rv = |{ x }/|.
 CALL METHOD ('ZCL_GOGEN_T_DYNRECVSUPPLIED')=>('VAL') EXPORTING p = 7 RECEIVING r = x.
 rv = |{ rv }{ x }/|.
 TRY.
 CALL METHOD ('ZCL_GOGEN_T_DYNRECVSUPPLIED')=>('VAL') EXPORTING sup_p = 123 RECEIVING r = x.
 rv = |{ rv }silent|.
 CATCH cx_sy_dyn_call_param_not_found. rv = |{ rv }CX_SY_DYN_CALL_PARAM_NOT_FOUND/|.
 ENDTRY.
 rv = rv && literal( ).
 ENDMETHOD.
ENDCLASS.
