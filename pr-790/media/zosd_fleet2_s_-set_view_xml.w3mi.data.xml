<mvc:View controllerName="l3.fleet2.set.Set" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" displayBlock="true">
  <App id="app">
    <Page id="page" title="{i18n>appTitle}">
      <headerContent>
        <HBox id="liveBox" alignItems="Center"/>
      </headerContent>
      <content>
        <MessageStrip id="answer" visible="false" showIcon="true" showCloseButton="true" class="sapUiSmallMargin"/>
        <IconTabBar id="tabs" expandable="false" class="sapUiResponsiveContentPadding" selectedKey="{cfg>/first}">
          <items>
            <IconTabFilter id="tabSettings" key="settings" icon="sap-icon://action-settings" text="{i18n>tabSettings}" visible="{cfg>/hasSettings}">
              <VBox><Text text="{i18n>settingsHint}" class="sapUiSmallMarginBottom"/></VBox>
              <Table id="settings" items="{set>/settings}" noDataText="{i18n>noSettings}">
                <columns>
                  <Column><Text text="{i18n>colSetting}"/></Column>
                  <Column hAlign="End"><Text text="{i18n>colCurrent}"/></Column>
                  <Column hAlign="End"><Text text="{i18n>colDefault}"/></Column>
                  <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colBounds}"/></Column>
                  <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colChanged}"/></Column>
                  <Column hAlign="End"><Text text=""/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <ObjectIdentifier title="{set>ParamName}" text="{set>about}"/>
                      <ObjectStatus text="{set>ParamVal}" state="{= ${set>Origin} === 'DSL' ? 'None' : 'Information' }"/>
                      <Text text="{set>DslValue}"/>
                      <Text text="{set>bounds}"/>
                      <Text text="{set>changed}"/>
                      <HBox justifyContent="End">
                        <Button text="{i18n>SetSetting}" press=".askChange"/>
                        <Button text="{i18n>ResetSetting}" press=".askReset" enabled="{= ${set>Origin} !== 'DSL' }" class="sapUiTinyMarginBegin"/>
                      </HBox>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
              <Table id="changes" items="{set>/changes}" growing="true" growingThreshold="20" headerText="{i18n>changeLog}" class="sapUiMediumMarginTop" noDataText="{i18n>noChanges}">
                <columns>
                  <Column><Text text="{i18n>colSetting}"/></Column>
                  <Column><Text text="{i18n>colChange}"/></Column>
                  <Column><Text text="{i18n>colNote}"/></Column>
                  <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colChanged}"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{set>ParamName}"/>
                      <Text text="{set>change}"/>
                      <Text text="{set>NoteText}"/>
                      <Text text="{set>changed}"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </IconTabFilter>
            <IconTabFilter id="tabSchedule" key="schedule" icon="sap-icon://appointment" text="{i18n>tabSchedule}" visible="{cfg>/hasSchedule}">
              <VBox>
                <Label text="{i18n>scheduleNow}"/>
                <ObjectStatus id="scheduleStatus" text="{set>/schedule}" state="{= ${set>/scheduled} ? 'Success' : 'None' }" class="sapMObjectStatusLarge"/>
                <Text text="{i18n>scheduleHint}" class="sapUiSmallMarginTop"/>
                <HBox class="sapUiSmallMarginTop">
                  <Button id="schedule" text="{i18n>Schedule}" type="Emphasized" press=".doSchedule"/>
                  <Button id="unschedule" text="{i18n>Unschedule}" press=".doUnschedule" class="sapUiTinyMarginBegin"/>
                </HBox>
              </VBox>
            </IconTabFilter>
            <IconTabFilter id="tabKill" key="kill" icon="sap-icon://stop" text="{i18n>tabKill}" visible="{cfg>/hasKill}">
              <VBox>
                <Label text="{i18n>killNow}"/>
                <ObjectStatus id="killStatus" text="{set>/kill/text}" state="{= ${set>/kill/set} ? 'Error' : 'Success' }" class="sapMObjectStatusLarge"/>
                <Text text="{set>/kill/since}" class="sapUiTinyMarginTop"/>
                <Text text="{i18n>killHint}" class="sapUiSmallMarginTop"/>
                <HBox class="sapUiSmallMarginTop">
                  <Button id="setKill" text="{i18n>SetKill}" type="Reject" press=".askSetKill" visible="{= !${set>/kill/set} }"/>
                  <Button id="clearKill" text="{i18n>ClearKill}" type="Accept" press=".askClearKill" visible="{set>/kill/set}"/>
                </HBox>
              </VBox>
            </IconTabFilter>
            <IconTabFilter id="tabDoctor" key="doctor" icon="sap-icon://stethoscope" text="{i18n>tabDoctor}" visible="{cfg>/hasDoctor}">
              <VBox>
                <Text text="{i18n>doctorHint}" class="sapUiSmallMarginBottom"/>
                <Button id="doctor" text="{i18n>Doctor}" type="Emphasized" press=".doDoctor"/>
              </VBox>
              <Table id="journal" items="{set>/doctor}" growing="true" growingThreshold="20" headerText="{i18n>journal}" class="sapUiSmallMarginTop" noDataText="{i18n>noJournal}">
                <columns>
                  <Column><Text text="{i18n>colWhen}"/></Column>
                  <Column><Text text="{i18n>colAction}"/></Column>
                  <Column><Text text="{i18n>colReason}"/></Column>
                  <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colWhere}"/></Column>
                </columns>
                <items>
                  <ColumnListItem>
                    <cells>
                      <Text text="{set>when}"/>
                      <Text text="{set>DocAction}"/>
                      <Text text="{set>Reason}"/>
                      <Text text="{set>where}"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </IconTabFilter>
          </items>
        </IconTabBar>
      </content>
    </Page>
  </App>
</mvc:View>
