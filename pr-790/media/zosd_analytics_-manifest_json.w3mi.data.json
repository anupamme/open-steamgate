{
  "_version": "1.59.0",
  "sap.app": {
    "id": "stg.analytics",
    "type": "application",
    "title": "Flight analytics",
    "description": "open-steamgate analytical list page over the flight cube (ZC_STG_FLIGHTCUBE)",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "dataSources": {
      "mainService": {
        "uri": "../../../../opu/odata/sap/ZSTG_SADL_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "annotations": [
            "localAnnotations"
          ]
        }
      },
      "localAnnotations": {
        "uri": "annotations/annotations.xml",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "annotations/annotations.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Flight-analyze": {
          "semanticObject": "Flight",
          "action": "analyze",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.suite.ui.generic.template": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "stg.analytics.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "useBatch": true,
          "defaultCountMode": "Inline",
          "defaultBindingMode": "TwoWay",
          "refreshAfterChange": false
        }
      }
    }
  },
  "sap.ui.generic.app": {
    "_version": "1.3.0",
    "settings": {
      "flexibilityEnabled": false
    },
    "pages": {
      "AnalyticalListPage|Zc_Stg_Flightcube": {
        "entitySet": "Zc_Stg_FlightcubeSet",
        "component": {
          "name": "sap.suite.ui.generic.template.AnalyticalListPage",
          "list": true,
          "settings": {
            "tableType": "AnalyticalTable",
            "defaultContentView": "charttable",
            "showGoButton": false,
            "condensedTableLayout": true,
            "smartVariantManagement": false,
            "dataLoadSettings": {
              "loadDataOnAppLaunch": "always"
            }
          }
        }
      }
    }
  }
}
