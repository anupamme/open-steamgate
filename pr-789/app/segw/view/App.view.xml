<mvc:View
  controllerName="stg.segw.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:f="sap.ui.layout.form"
  xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
  displayBlock="true"
  height="100%">
  <Page id="page" title="SEGW: Service Builder" showHeader="true">
    <headerContent>
      <Label text="Project" labelFor="project"/>
      <Select id="project" items="{path: '/ProjectSet', sorter: {path: 'Project'}}" change=".onProjectChange" width="18rem">
        <core:Item xmlns:core="sap.ui.core" key="{Project}" text="{Project}"/>
      </Select>
      <Button id="newProject" text="New project" icon="sap-icon://add-document" press=".onNewProject"/>
      <Button id="save" text="Save" icon="sap-icon://save" type="Emphasized" press=".onSave"/>
      <Button id="generate" text="Generate" icon="sap-icon://generate-shortcut" press=".onGenerate"/>
      <Button id="import" text="Import IWPR" icon="sap-icon://upload" press=".onImport"/>
      <Button id="export" text="Export IWPR" icon="sap-icon://download" press=".onExport"/>
    </headerContent>
    <content>
      <l:Splitter id="splitter" height="100%">
        <Tree id="tree" mode="SingleSelectMaster" selectionChange=".onSelect"
          items="{path: 'tree>/nodes', parameters: {arrayNames: ['nodes']}}" noDataText="Pick a project">
          <layoutData><l:SplitterLayoutData size="34%"/></layoutData>
          <StandardTreeItem title="{tree>text}" icon="{tree>icon}"/>
        </Tree>
        <Page id="detail" showHeader="true" title="{node>/title}" backgroundDesign="List">
          <headerContent>
            <Button id="add0" text="{node>/adds/0/label}" icon="sap-icon://add" press=".onAdd" visible="{= !!${node>/adds/0/label}}" app:add="{node>/adds/0/key}"/>
            <Button id="add1" text="{node>/adds/1/label}" icon="sap-icon://add" press=".onAdd" visible="{= !!${node>/adds/1/label}}" app:add="{node>/adds/1/key}"/>
            <Button id="delete" text="Delete" icon="sap-icon://delete" type="Reject" press=".onDelete" visible="{= !!${node>/path} &amp;&amp; ${node>/entity} !== 'Project'}"/>
          </headerContent>
          <content>
            <MessageStrip id="hint" text="Select a node of the tree: its fields are the row of the /IWBEP/I_SB* table it lives in, edited in place." showIcon="true" class="sapUiSmallMargin" visible="{= !${node>/path} &amp;&amp; !${node>/folder}}"/>
            <VBox id="overview" visible="false" class="sapUiSmallMargin"/>
            <f:SimpleForm id="form" editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" columnsL="1" columnsM="1" visible="{= !!${node>/path}}"/>
            <f:SimpleForm id="textForm" editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" columnsL="1" columnsM="1" visible="false"/>
          </content>
        </Page>
      </l:Splitter>
    </content>
  </Page>
</mvc:View>
