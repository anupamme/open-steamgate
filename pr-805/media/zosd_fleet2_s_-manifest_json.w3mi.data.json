{
  "_version": "1.59.0",
  "sap.app": {
    "id": "l3.fleet2.set",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "i18n": "i18n/i18n.properties",
    "dataSources": {
      "mainService": {
        "uri": "../../../../opu/odata/sap/ZL3C_FLEET2_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
