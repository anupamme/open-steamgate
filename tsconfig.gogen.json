{
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2024",
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "tools/gogen/ir.ts",
    "tools/gogen/emit-go-types.ts",
    "tools/gogen/emit-local-constants.ts",
    "tools/gogen/emit-builtins.ts",
    "tools/gogen/emit-bytes.ts",
    "tools/gogen/emit-int8.ts",
    "tools/gogen/emit-exception.ts",
    "tools/gogen/emit-table-move.ts",
    "tools/gogen/sink-locals.ts",
    "tools/gogen/frontend-owned.ts",
    "tools/gogen/frontend-types.ts",
    "tools/gogen/emit-go-types.ts",
    "tools/gogen/host-io.ts",
    "tools/gogen/fold-scalars.ts",
    "tools/gogen/append.ts",
    "tools/gogen/ir-children.ts",
    "tools/gogen/emit-ownership.ts",
    "tools/gogen/emit-packedint.ts",
    "tools/gogen/emit-owned.ts",
    "tools/gogen/frontend-session-types.ts",
    "tools/gogen/frontend-session-consumer-probe.ts",
    "tools/gogen/frontend-diagnostics.ts",
    "tools/gogen/frontend-literals.ts",
    "tools/gogen/frontend-boolx.ts",
    "tools/gogen/symbols.ts",
    "tools/gogen/go-symbols.mjs",
    "tools/gogen/emit-constructors.ts",
    "tools/gogen/frontend-find-results.ts",
    "tools/osd-samc.mjs"
  ]
}
