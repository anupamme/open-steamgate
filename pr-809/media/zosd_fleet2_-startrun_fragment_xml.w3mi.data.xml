<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="startDialog" title="{cockpitI18n>startTitle}" contentWidth="30rem" afterClose=".startClosed">
    <VBox class="sapUiSmallMargin">
      <Label text="{cockpitI18n>startDate}" labelFor="startDate" required="true"/>
      <DatePicker id="startDate" value="{start>/date}" valueFormat="yyyyMMdd" displayFormat="medium" change=".startDateChanged" width="100%"/>
      <Label text="{cockpitI18n>startMode}" labelFor="startMode" class="sapUiSmallMarginTop"/>
      <SegmentedButton id="startMode" selectedKey="{start>/mode}">
        <items>
          <SegmentedButtonItem key="P" text="{cockpitI18n>modeJobs}"/>
          <SegmentedButtonItem key="S" text="{cockpitI18n>modeNow}"/>
        </items>
      </SegmentedButton>
      <Text id="startModeHint" class="sapUiTinyMarginTop" text="{= ${start>/mode} === 'P' ? ${cockpitI18n>modeJobsHint} : ${cockpitI18n>modeNowHint} }"/>
      <HBox visible="{start>/simulate}" alignItems="Center" class="sapUiSmallMarginTop">
        <Switch id="startSim" state="{start>/sim}"/>
        <Label text="{start>/twinText}" labelFor="startSim" class="sapUiTinyMarginBegin" wrapping="true"/>
      </HBox>
      <MessageStrip id="startOpen" type="Warning" showIcon="true" class="sapUiSmallMarginTop" visible="{= !!${start>/open} }" text="{start>/open}"/>
    </VBox>
    <beginButton>
      <Button id="startGo" text="{cockpitI18n>start}" type="Emphasized" press=".startGo" enabled="{= !${start>/busy} }"/>
    </beginButton>
    <endButton>
      <Button id="startCancel" text="{cockpitI18n>cancel}" press=".startCancel"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
