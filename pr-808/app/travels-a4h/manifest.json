{
  "_version": "1.59.0",
  "sap.app": {
    "id": "stg.travel",
    "type": "application",
    "title": "Travels (A4H)",
    "description": "the same app, reading ZOSD_006_DEMO_SRV on another system through a destination",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZOSD_006_DEMO_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Travel-manageRemote": {
          "semanticObject": "Travel",
          "action": "manageRemote",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      },
      "outbounds": {
        "BookingDisplay": {
          "semanticObject": "Booking",
          "action": "display"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.suite.ui.generic.template": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "stg.travel.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "useBatch": true,
          "defaultCountMode": "Inline",
          "defaultBindingMode": "TwoWay",
          "refreshAfterChange": false
        }
      }
    }
  },
  "sap.ui.generic.app": {
    "_version": "1.3.0",
    "settings": {
      "flexibilityEnabled": false
    },
    "pages": {
      "ListReport|Travel": {
        "entitySet": "TravelSet",
        "component": {
          "name": "sap.suite.ui.generic.template.ListReport",
          "list": true,
          "settings": {
            "dataLoadSettings": {
              "loadDataOnAppLaunch": "always"
            },
            "smartVariantManagement": false,
            "condensedTableLayout": true
          }
        },
        "pages": {
          "ObjectPage|Travel": {
            "entitySet": "TravelSet",
            "component": {
              "name": "sap.suite.ui.generic.template.ObjectPage",
              "settings": {
                "editableHeaderContent": false
              }
            },
            "pages": {
              "ObjectPage|to_Bookings": {
                "navigationProperty": "to_Bookings",
                "entitySet": "BookingSet",
                "component": {
                  "name": "sap.suite.ui.generic.template.ObjectPage",
                  "settings": {
                    "editableHeaderContent": false
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}